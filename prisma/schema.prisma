generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_OWNER
  DIRECTOR
  TEACHER
  PARENT
  STUDENT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CefrLevel {
  PRE_A1
  A1
  A2
  B1
  B2
  C1
  C2
  MIXED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  PLANNED
  COMPLETED
  CANCELLED
  SUBSTITUTE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ScheduleGenerationStatus {
  READY
  APPLIED
  DISCARDED
  FAILED
}

enum FeedbackStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackCategory {
  BUG
  ACCESSIBILITY
  DATA_PROBLEM
  IDEA
  OTHER
}

enum FeedbackPlatform {
  IOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  OTHER
}

enum StoredFilePurpose {
  IMPORT_SOURCE
  PROFILE_ATTACHMENT
  SITE_IMAGE
  CONTRACT
  LEARNING_MATERIAL
  HOMEWORK_SUBMISSION
  FEEDBACK_SCREENSHOT
  MESSAGE_ATTACHMENT
}

enum ImportStatus {
  PREVIEW_READY
  COMMITTED
  FAILED
  ARCHIVED
}

enum InvitationKind {
  EMAIL
  ROLE_QR
}

enum RecordEntityType {
  USER
  ROOM
  GROUP
}

enum RecordChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED_PENDING_REVIEW
  ACCEPTED
  EXPIRED
}

enum ContractAcceptanceMode {
  DOCUMENTARY
  EXTERNAL_SIGNATURE
}

enum ContractDocumentKind {
  AGREEMENT_RODO
  PRICE_LIST
  SCHEDULE
  OTHER
}

enum PaymentStatus {
  UNSET
  PENDING
  PAID
  OVERDUE
}

enum MessageKind {
  CHAT
  ANNOUNCEMENT
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum ConversationAccessPurpose {
  SAFETY
  COMPLAINT
  LEGAL
  SUPPORT
  OTHER
}

enum HomeworkSubmissionStatus {
  NOT_OPENED
  OPENED
  SUBMITTED
  LATE
  REVIEWED
}

enum ScheduleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ScheduleChangeRequestKind {
  RESCHEDULE
  CHANGE_TEACHER
  CHANGE_ROOM
  CANCEL
  OTHER
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timeZone  String   @default("Europe/Warsaw")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteContent Json?

  users                      User[]
  locations                  Location[]
  rooms                      Room[]
  courseGroups               CourseGroup[]
  parentLinks                ParentChild[]
  scheduleSlots              ScheduleSlot[]
  attendance                 AttendanceRecord[]
  lessonCheckIns             LessonCheckIn[]
  availabilityWindows        AvailabilityWindow[]
  studentAvailabilityWindows StudentAvailabilityWindow[]
  schedulingRequirements     SchedulingRequirement[]
  scheduleGenerations        ScheduleGeneration[]
  auditLogs                  AuditLog[]
  feedbackReports            FeedbackReport[]
  invitations                Invitation[]
  storedFiles                StoredFile[]
  importBatches              ImportBatch[]
  recordChanges              RecordChangeRequest[]
  pageVisits                 PageVisit[]
  contracts                  Contract[]
  contractAssignments        ContractAssignment[]
  paymentRecords             PaymentRecord[]
  contractDocuments          ContractDocument[]
  contractDocumentViews      ContractDocumentView[]
  paymentInstallments        PaymentInstallment[]
  conversations              Conversation[]
  conversationParticipants   ConversationParticipant[]
  messages                   Message[]
  announcements              Announcement[]
  messageReads               MessageRead[]
  emailDeliveries            EmailDelivery[]
  conversationAccesses       DirectorConversationAccess[]
  messageAcknowledgements    MessageAcknowledgement[]
  messageAttachments         MessageAttachment[]
  notificationStates         NotificationState[]
  onboardingProgress         OnboardingProgress[]
  learningMaterials          LearningMaterial[]
  learningMaterialRecipients LearningMaterialRecipient[]
  homeworkAssignments        HomeworkAssignment[]
  homeworkSubmissions        HomeworkSubmission[]
  progressObservations       StudentProgressObservation[]
  lessonCancellations        LessonCancellation[]
  scheduleChangeRequests     ScheduleChangeRequest[]
  locationTravelRules        LocationTravelRule[]
}

model Location {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  name       String
  address    String?
  isOnline   Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rooms               Room[]
  courseGroups        CourseGroup[]
  availabilityWindows AvailabilityWindow[]
  travelRulesFrom     LocationTravelRule[] @relation("TravelFromLocation")
  travelRulesTo       LocationTravelRule[] @relation("TravelToLocation")

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model User {
  id               String      @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  schoolId         String      @db.Uuid
  email            String      @unique
  name             String
  role             String      @default("PARENT")
  status           UserStatus  @default(INVITED)
  emailVerified    Boolean     @default(false)
  image            String?
  phone            String?
  externalId       String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?    @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  archivedAt       DateTime?
  pageVisits       PageVisit[]

  school                         School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sessions                       Session[]
  accounts                       Account[]
  twoFactors                     TwoFactor[]
  teacherProfile                 TeacherProfile?
  studentProfile                 StudentProfile?
  parentLinks                    ParentChild[]                @relation("ParentLinks")
  childLinks                     ParentChild[]                @relation("ChildLinks")
  groupTeaching                  GroupTeacher[]
  enrollments                    Enrollment[]
  teachingSlots                  ScheduleSlot[]               @relation("ScheduleTeacher")
  createdSlots                   ScheduleSlot[]               @relation("ScheduleCreator")
  attendanceAsStudent            AttendanceRecord[]           @relation("AttendanceStudent")
  attendanceRecorded             AttendanceRecord[]           @relation("AttendanceRecorder")
  lessonCheckIns                 LessonCheckIn[]              @relation("LessonCheckInStudent")
  availabilityWindows            AvailabilityWindow[]         @relation("AvailabilityTeacher")
  studentAvailabilityWindows     StudentAvailabilityWindow[]
  schedulingRequirements         SchedulingRequirement[]      @relation("RequirementTeacher")
  createdScheduleGenerations     ScheduleGeneration[]         @relation("ScheduleGenerationCreator")
  proposedScheduleSlots          ScheduleProposalSlot[]       @relation("ProposalTeacher")
  auditEvents                    AuditLog[]                   @relation("AuditActor")
  feedbackReports                FeedbackReport[]             @relation("FeedbackReporter")
  sentInvitations                Invitation[]                 @relation("InvitationSender")
  usedInvitations                Invitation[]                 @relation("InvitationRecipient")
  uploadedFiles                  StoredFile[]                 @relation("FileUploader")
  importBatches                  ImportBatch[]                @relation("ImportCreator")
  requestedRecordChanges         RecordChangeRequest[]        @relation("RecordChangeRequester")
  reviewedRecordChanges          RecordChangeRequest[]        @relation("RecordChangeReviewer")
  createdContractVersions        ContractVersion[]            @relation("ContractVersionCreator")
  contractAssignmentsParent      ContractAssignment[]         @relation("ContractParent")
  contractAssignmentsChild       ContractAssignment[]         @relation("ContractStudent")
  contractAcceptances            ContractAcceptance[]         @relation("ContractAcceptor")
  contractDocumentViews          ContractDocumentView[]
  paymentRecordsAsStudent        PaymentRecord[]              @relation("PaymentStudent")
  changedPaymentRecords          PaymentRecord[]              @relation("PaymentChangedBy")
  changedPaymentInstallments     PaymentInstallment[]         @relation("PaymentInstallmentChangedBy")
  authoredMessages               Message[]                    @relation("MessageAuthor")
  authoredAnnouncements          Announcement[]               @relation("AnnouncementAuthor")
  messageReads                   MessageRead[]
  emailDeliveries                EmailDelivery[]              @relation("EmailRecipient")
  directorConversationAccess     DirectorConversationAccess[] @relation("ConversationAccessDirector")
  createdConversations           Conversation[]               @relation("ConversationCreator")
  conversationMemberships        ConversationParticipant[]    @relation("ConversationParticipantUser")
  addedConversationMembers       ConversationParticipant[]    @relation("ConversationParticipantAdder")
  messageAcknowledgements        MessageAcknowledgement[]
  notificationStates             NotificationState[]
  onboardingProgress             OnboardingProgress?
  createdLearningMaterials       LearningMaterial[]           @relation("LearningMaterialCreator")
  learningMaterialRecipients     LearningMaterialRecipient[]
  createdHomeworkAssignments     HomeworkAssignment[]         @relation("HomeworkAssignmentCreator")
  homeworkSubmissions            HomeworkSubmission[]         @relation("HomeworkSubmissionStudent")
  reviewedHomeworkSubmissions    HomeworkSubmission[]         @relation("HomeworkSubmissionReviewer")
  progressAsStudent              StudentProgressObservation[] @relation("ProgressObservationStudent")
  recordedProgress               StudentProgressObservation[] @relation("ProgressObservationRecorder")
  cancelledLessons               LessonCancellation[]         @relation("LessonCancellationActor")
  requestedScheduleChanges       ScheduleChangeRequest[]      @relation("ScheduleChangeRequester")
  reviewedScheduleChanges        ScheduleChangeRequest[]      @relation("ScheduleChangeReviewer")
  proposedScheduleChangeTeaching ScheduleChangeRequest[]      @relation("ScheduleChangeProposedTeacher")

  @@unique([schoolId, externalId])
  @@index([schoolId, role, status])
  @@index([archivedAt])
}

model Session {
  id             String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String   @db.Uuid
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @db.Uuid
  invitedById    String         @db.Uuid
  acceptedUserId String?        @db.Uuid
  kind           InvitationKind @default(EMAIL)
  email          String?
  name           String?
  role           String
  tokenHash      String         @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  maxUses        Int?           @default(1)
  useCount       Int            @default(0)
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school       School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invitedBy    User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser User?  @relation("InvitationRecipient", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, email, acceptedAt, revokedAt])
  @@index([schoolId, kind, acceptedAt, revokedAt])
  @@index([expiresAt])
}

model RecordChangeRequest {
  id            String             @id @default(uuid()) @db.Uuid
  schoolId      String             @db.Uuid
  requestedById String             @db.Uuid
  reviewedById  String?            @db.Uuid
  entityType    RecordEntityType
  entityId      String
  payload       Json
  changedFields String[]
  status        RecordChangeStatus @default(PENDING)
  reviewNote    String?
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?

  school      School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  requestedBy User   @relation("RecordChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?  @relation("RecordChangeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, entityType, entityId, createdAt])
  @@index([requestedById, createdAt])
}

model TeacherProfile {
  userId      String  @id @db.Uuid
  displayName String?
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model StudentProfile {
  userId    String    @id @db.Uuid
  birthDate DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ParentChild {
  schoolId   String    @db.Uuid
  parentId   String    @db.Uuid
  childId    String    @db.Uuid
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parent User   @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Restrict)
  child  User   @relation("ChildLinks", fields: [childId], references: [id], onDelete: Restrict)

  @@id([parentId, childId])
  @@index([schoolId, childId])
  @@index([schoolId, archivedAt])
}

model Room {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  locationId String    @db.Uuid
  name       String
  capacity   Int?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  school                  School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  location                Location                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  scheduleSlots           ScheduleSlot[]
  availabilityWindows     AvailabilityWindow[]
  schedulingRequirements  SchedulingRequirement[] @relation("RequirementRoom")
  proposedScheduleSlots   ScheduleProposalSlot[]
  proposedScheduleChanges ScheduleChangeRequest[] @relation("ScheduleChangeProposedRoom")

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@index([locationId, isActive])
}

model CourseGroup {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  locationId String    @db.Uuid
  name       String
  cefrLevel  CefrLevel @default(MIXED)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  location              Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  teachers              GroupTeacher[]
  enrollments           Enrollment[]
  scheduleSlots         ScheduleSlot[]
  availabilityWindows   AvailabilityWindow[]
  schedulingRequirement SchedulingRequirement?
  proposedScheduleSlots ScheduleProposalSlot[]
  conversation          Conversation?
  learningMaterials     LearningMaterial[]
  homeworkAssignments   HomeworkAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@index([locationId, isActive])
}

model GroupTeacher {
  groupId    String    @db.Uuid
  teacherId  String    @db.Uuid
  isPrimary  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  archivedAt DateTime?

  group   CourseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacher User        @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([groupId, teacherId])
  @@index([teacherId])
  @@index([archivedAt])
}

model Enrollment {
  groupId   String           @db.Uuid
  studentId String           @db.Uuid
  status    EnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  endedAt   DateTime?

  group   CourseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student User        @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([groupId, studentId])
  @@index([studentId, status])
}

model ScheduleSlot {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @db.Uuid
  groupId        String         @db.Uuid
  roomId         String         @db.Uuid
  teacherId      String         @db.Uuid
  createdById    String         @db.Uuid
  startAt        DateTime
  endAt          DateTime
  timeZone       String         @default("Europe/Warsaw")
  recurrenceRule String?
  seriesId       String?        @db.Uuid
  status         ScheduleStatus @default(PLANNED)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?
  topic          String?
  isLocked       Boolean        @default(false)
  generationId   String?        @db.Uuid

  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group                CourseGroup                  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  room                 Room                         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher              User                         @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy            User                         @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendance           AttendanceRecord[]
  checkIns             LessonCheckIn[]
  cancellation         LessonCancellation?
  changeRequests       ScheduleChangeRequest[]
  progressObservations StudentProgressObservation[]
  generation           ScheduleGeneration?          @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([schoolId, startAt, endAt])
  @@index([roomId, startAt, endAt])
  @@index([teacherId, startAt, endAt])
  @@index([groupId, startAt, endAt])
  @@index([seriesId])
  @@index([generationId])
}

model AvailabilityWindow {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  teacherId   String?  @db.Uuid
  roomId      String?  @db.Uuid
  groupId     String?  @db.Uuid
  locationId  String?  @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  isAvailable Boolean  @default(true)
  preference  Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher  User?        @relation("AvailabilityTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  room     Room?        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  group    CourseGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([schoolId, weekday, startMinute, endMinute])
  @@index([teacherId, weekday])
  @@index([roomId, weekday])
  @@index([groupId, weekday])
  @@index([locationId, weekday])
}

model StudentAvailabilityWindow {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  studentId   String   @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  preference  Int      @default(10)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school  School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([schoolId, weekday, startMinute, endMinute])
  @@index([studentId, weekday])
}

model SchedulingRequirement {
  id                   String   @id @default(uuid()) @db.Uuid
  schoolId             String   @db.Uuid
  groupId              String   @unique @db.Uuid
  teacherId            String?  @db.Uuid
  preferredRoomId      String?  @db.Uuid
  lessonsPerWeek       Int      @default(2)
  durationMinutes      Int      @default(60)
  allowedWeekdays      Int[]    @default([1, 2, 3, 4, 5])
  preferredWeekdays    Int[]    @default([])
  earliestStartMinute  Int      @default(780)
  latestEndMinute      Int      @default(1260)
  preferredStartMinute Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group         CourseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacher       User?       @relation("RequirementTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  preferredRoom Room?       @relation("RequirementRoom", fields: [preferredRoomId], references: [id], onDelete: Restrict)

  @@index([schoolId, isActive])
  @@index([teacherId])
  @@index([preferredRoomId])
}

model ScheduleGeneration {
  id          String                   @id @default(uuid()) @db.Uuid
  schoolId    String                   @db.Uuid
  createdById String                   @db.Uuid
  weekStart   DateTime                 @db.Date
  status      ScheduleGenerationStatus @default(READY)
  score       Int
  summary     Json
  createdAt   DateTime                 @default(now())
  appliedAt   DateTime?

  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User                   @relation("ScheduleGenerationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  proposals ScheduleProposalSlot[]
  slots     ScheduleSlot[]

  @@index([schoolId, weekStart, createdAt])
  @@index([createdById, createdAt])
}

model ScheduleProposalSlot {
  id           String   @id @default(uuid()) @db.Uuid
  generationId String   @db.Uuid
  groupId      String   @db.Uuid
  roomId       String   @db.Uuid
  teacherId    String   @db.Uuid
  startAt      DateTime
  endAt        DateTime
  score        Int      @default(0)
  explanation  String?

  generation ScheduleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  group      CourseGroup        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  room       Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher    User               @relation("ProposalTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([generationId, startAt])
  @@index([groupId, startAt, endAt])
  @@index([roomId, startAt, endAt])
  @@index([teacherId, startAt, endAt])
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  scheduleSlotId String           @db.Uuid
  studentId      String           @db.Uuid
  recordedById   String           @db.Uuid
  status         AttendanceStatus
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  student      User         @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([scheduleSlotId, studentId])
  @@index([schoolId, studentId, createdAt])
}

/// Potwierdzenie ucznia, że dotarł na zajęcia. Nie zastępuje oficjalnej
/// obecności wpisanej przez wykładowcę lub dyrektora.
model LessonCheckIn {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  scheduleSlotId String   @db.Uuid
  studentId      String   @db.Uuid
  checkedInAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  student      User         @relation("LessonCheckInStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([scheduleSlotId, studentId])
  @@index([schoolId, studentId, checkedInAt])
}

/// Niezmienny zapis odwołania lekcji. Powód jest widoczny tylko dla osób,
/// które mają dostęp do lekcji; wysyłka powiadomień korzysta z osobnego outboxu.
model LessonCancellation {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  scheduleSlotId String   @unique @db.Uuid
  cancelledById  String   @db.Uuid
  reason         String
  notifyGroup    Boolean  @default(true)
  cancelledAt    DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  cancelledBy  User         @relation("LessonCancellationActor", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([schoolId, cancelledAt])
  @@index([cancelledById, cancelledAt])
}

/// Propozycja zmiany grafiku składana przez wykładowcę. Dopiero akceptacja
/// dyrektora może zmienić opublikowany ScheduleSlot.
model ScheduleChangeRequest {
  id                String                      @id @default(uuid()) @db.Uuid
  schoolId          String                      @db.Uuid
  scheduleSlotId    String                      @db.Uuid
  requestedById     String                      @db.Uuid
  reviewedById      String?                     @db.Uuid
  kind              ScheduleChangeRequestKind
  status            ScheduleChangeRequestStatus @default(PENDING)
  reason            String
  proposedStartAt   DateTime?
  proposedEndAt     DateTime?
  proposedTeacherId String?                     @db.Uuid
  proposedRoomId    String?                     @db.Uuid
  reviewNote        String?
  createdAt         DateTime                    @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime                    @updatedAt

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  scheduleSlot    ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  requestedBy     User         @relation("ScheduleChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy      User?        @relation("ScheduleChangeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  proposedTeacher User?        @relation("ScheduleChangeProposedTeacher", fields: [proposedTeacherId], references: [id], onDelete: Restrict)
  proposedRoom    Room?        @relation("ScheduleChangeProposedRoom", fields: [proposedRoomId], references: [id], onDelete: Restrict)

  @@index([schoolId, status, createdAt])
  @@index([scheduleSlotId, status])
  @@index([requestedById, createdAt])
  @@index([proposedTeacherId])
  @@index([proposedRoomId])
}

/// Minimalny czas przejazdu pomiędzy dwiema fizycznymi lokalizacjami.
/// Reguła kierunkowa pozwala później uwzględnić różne czasy w obie strony.
model LocationTravelRule {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  fromLocationId String   @db.Uuid
  toLocationId   String   @db.Uuid
  minutes        Int
  note           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  fromLocation Location @relation("TravelFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location @relation("TravelToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@unique([schoolId, fromLocationId, toLocationId])
  @@index([schoolId, isActive])
  @@index([fromLocationId, toLocationId])
}

model LearningMaterial {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @db.Uuid
  groupId      String    @db.Uuid
  createdById  String    @db.Uuid
  storedFileId String?   @db.Uuid
  title        String
  description  String?
  externalUrl  String?
  audience     String    @default("GROUP")
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group      CourseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy  User        @relation("LearningMaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  storedFile StoredFile? @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  recipients LearningMaterialRecipient[]

  @@index([schoolId, publishedAt])
  @@index([groupId, archivedAt, publishedAt])
  @@index([createdById, createdAt])
}

model LearningMaterialRecipient {
  materialId String @db.Uuid
  userId     String @db.Uuid
  schoolId   String @db.Uuid
  createdAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@id([materialId, userId])
  @@index([schoolId, userId])
}

model HomeworkAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @db.Uuid
  groupId      String    @db.Uuid
  createdById  String    @db.Uuid
  title        String
  instructions String
  dueAt        DateTime?
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group       CourseGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("HomeworkAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions HomeworkSubmission[]

  @@index([schoolId, publishedAt])
  @@index([groupId, archivedAt, dueAt])
  @@index([createdById, createdAt])
}

model HomeworkSubmission {
  id              String                   @id @default(uuid()) @db.Uuid
  schoolId        String                   @db.Uuid
  assignmentId    String                   @db.Uuid
  studentId       String                   @db.Uuid
  reviewedById    String?                  @db.Uuid
  storedFileId    String?                  @db.Uuid
  status          HomeworkSubmissionStatus @default(NOT_OPENED)
  studentNote     String?
  teacherFeedback String?
  openedAt        DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assignment HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    User               @relation("HomeworkSubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  reviewedBy User?              @relation("HomeworkSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  storedFile StoredFile?        @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([schoolId, status, updatedAt])
  @@index([studentId, status, updatedAt])
  @@index([reviewedById, reviewedAt])
}

/// Opisowa obserwacja postępu z konkretnego dnia. Wartości 1-5 są pomocą
/// pedagogiczną, nie diagnozą ani automatyczną decyzją o uczniu.
model StudentProgressObservation {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  studentId      String   @db.Uuid
  recordedById   String   @db.Uuid
  scheduleSlotId String?  @db.Uuid
  speaking       Int
  listening      Int
  reading        Int
  writing        Int
  vocabulary     Int
  grammar        Int
  engagement     Int?
  note           String?
  observedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student      User          @relation("ProgressObservationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy   User          @relation("ProgressObservationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  scheduleSlot ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)

  @@unique([scheduleSlotId, studentId])
  @@index([schoolId, studentId, observedAt])
  @@index([recordedById, observedAt])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddressHash String?
  createdAt     DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  groupId     String?   @unique @db.Uuid
  directKey   String?   @unique
  kind        String    @default("GROUP")
  title       String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  school       School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group        CourseGroup?                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy    User?                        @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages     Message[]
  accesses     DirectorConversationAccess[]
  participants ConversationParticipant[]

  @@index([schoolId, updatedAt])
  @@index([schoolId, archivedAt])
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  schoolId       String    @db.Uuid
  addedById      String?   @db.Uuid
  addedAt        DateTime  @default(now())
  archivedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  addedBy      User?        @relation("ConversationParticipantAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([conversationId, userId])
  @@index([schoolId, userId, archivedAt])
  @@index([addedById, addedAt])
}

model Announcement {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  authorId        String   @db.Uuid
  subject         String
  body            String
  clientRequestId String
  createdAt       DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  author   User      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  messages Message[]

  @@unique([authorId, clientRequestId])
  @@index([schoolId, createdAt])
}

model Message {
  id                      String      @id @default(uuid()) @db.Uuid
  schoolId                String      @db.Uuid
  conversationId          String      @db.Uuid
  authorId                String      @db.Uuid
  announcementId          String?     @db.Uuid
  kind                    MessageKind @default(CHAT)
  subject                 String?
  body                    String
  clientRequestId         String
  requiresAcknowledgement Boolean     @default(false)
  createdAt               DateTime    @default(now())

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  conversation     Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author           User                     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  announcement     Announcement?            @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  reads            MessageRead[]
  deliveries       EmailDelivery[]
  acknowledgements MessageAcknowledgement[]
  attachments      MessageAttachment[]

  @@unique([authorId, clientRequestId])
  @@index([schoolId, createdAt])
  @@index([conversationId, createdAt])
  @@index([announcementId])
}

model MessageAcknowledgement {
  messageId      String   @db.Uuid
  userId         String   @db.Uuid
  schoolId       String   @db.Uuid
  acknowledgedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([schoolId, acknowledgedAt])
  @@index([userId, acknowledgedAt])
}

model MessageAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  messageId    String   @db.Uuid
  storedFileId String   @db.Uuid
  createdAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([messageId])
  @@index([storedFileId])
}

model MessageRead {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  schoolId  String   @db.Uuid
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([schoolId, readAt])
  @@index([userId, readAt])
}

model EmailDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @db.Uuid
  messageId      String              @db.Uuid
  recipientId    String              @db.Uuid
  status         EmailDeliveryStatus @default(QUEUED)
  attempts       Int                 @default(0)
  idempotencyKey String              @unique
  nextAttemptAt  DateTime            @default(now())
  lastErrorCode  String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Restrict)
  recipient User    @relation("EmailRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([messageId, recipientId])
  @@index([schoolId, status, nextAttemptAt])
  @@index([recipientId, createdAt])
}

model DirectorConversationAccess {
  id             String                    @id @default(uuid()) @db.Uuid
  schoolId       String                    @db.Uuid
  conversationId String                    @db.Uuid
  directorId     String                    @db.Uuid
  purpose        ConversationAccessPurpose
  reason         String
  expiresAt      DateTime
  createdAt      DateTime                  @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  director     User         @relation("ConversationAccessDirector", fields: [directorId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([conversationId, directorId, expiresAt])
}

model PageVisit {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  userId    String?  @db.Uuid
  path      String
  visitedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, visitedAt])
  @@index([schoolId, path, visitedAt])
  @@index([userId, visitedAt])
}

model FeedbackReport {
  id                   String           @id @default(uuid()) @db.Uuid
  schoolId             String           @db.Uuid
  reporterId           String?          @db.Uuid
  referenceCode        String           @unique
  reporterRole         UserRole
  status               FeedbackStatus   @default(NEW)
  category             FeedbackCategory @default(BUG)
  description          String
  route                String
  platform             FeedbackPlatform
  browser              String?
  appRelease           String
  diagnosticMetadata   Json?
  screenshotStorageKey String?
  screenshotConsentAt  DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  resolvedAt           DateTime?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  reporter User?  @relation("FeedbackReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([reporterId, createdAt])
  @@index([appRelease, createdAt])
}

model StoredFile {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @db.Uuid
  uploadedById String            @db.Uuid
  storageKey   String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String            @db.Char(64)
  purpose      StoredFilePurpose
  createdAt    DateTime          @default(now())
  archivedAt   DateTime?

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  uploadedBy          User                 @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  importBatches       ImportBatch[]        @relation("ImportSource")
  contractVersions    ContractVersion[]    @relation("ContractFile")
  messageAttachments  MessageAttachment[]
  signedAssignments   ContractAssignment[] @relation("SignedContractFile")
  contractDocuments   ContractDocument[]
  learningMaterials   LearningMaterial[]
  homeworkSubmissions HomeworkSubmission[]

  @@index([schoolId, purpose, createdAt])
  @@index([uploadedById, createdAt])
  @@index([archivedAt])
}

model NotificationState {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @db.Uuid
  userId          String    @db.Uuid
  notificationKey String
  readAt          DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([schoolId, updatedAt])
  @@index([userId, snoozedUntil])
}

model OnboardingProgress {
  userId      String    @id @db.Uuid
  schoolId    String    @db.Uuid
  version     Int       @default(1)
  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, updatedAt])
}

model Contract {
  id              String                 @id @default(uuid()) @db.Uuid
  schoolId        String                 @db.Uuid
  title           String
  acceptanceMode  ContractAcceptanceMode @default(DOCUMENTARY)
  serviceSummary  String
  requiresPayment Boolean                @default(true)
  paymentSummary  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  archivedAt      DateTime?

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  versions    ContractVersion[]
  assignments ContractAssignment[]

  @@index([schoolId, createdAt])
  @@index([schoolId, archivedAt])
}

model ContractVersion {
  id                        String                 @id @default(uuid()) @db.Uuid
  contractId                String                 @db.Uuid
  storedFileId              String                 @db.Uuid
  createdById               String                 @db.Uuid
  version                   Int
  sha256                    String                 @db.Char(64)
  title                     String                 @default("")
  acceptanceMode            ContractAcceptanceMode @default(DOCUMENTARY)
  serviceSummary            String                 @default("")
  requiresPayment           Boolean                @default(true)
  paymentSummary            String?
  paymentAmountCents        Int?
  paymentLabel              String?
  paymentDueDate            DateTime?              @db.Date
  serviceStartDate          DateTime?              @db.Date
  serviceEndDate            DateTime?              @db.Date
  cancellationSummary       String?
  requiresEarlyStartRequest Boolean                @default(false)
  installmentCount          Int?
  installmentAmountCents    Int?
  totalAmountCents          Int?
  createdAt                 DateTime               @default(now())

  contract    Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  storedFile  StoredFile           @relation("ContractFile", fields: [storedFileId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("ContractVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ContractAssignment[]
  documents   ContractDocument[]

  @@unique([contractId, version])
  @@index([storedFileId])
  @@index([createdById, createdAt])
  @@index([requiresPayment, paymentDueDate])
}

model ContractAssignment {
  id               String         @id @default(uuid()) @db.Uuid
  schoolId         String         @db.Uuid
  contractId       String         @db.Uuid
  versionId        String         @db.Uuid
  parentId         String         @db.Uuid
  studentId        String         @db.Uuid
  status           ContractStatus @default(SENT)
  sentAt           DateTime       @default(now())
  viewedAt         DateTime?
  signedFileId     String?        @unique @db.Uuid
  signedUploadedAt DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())

  school              School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  contract            Contract               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  version             ContractVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  parent              User                   @relation("ContractParent", fields: [parentId], references: [id], onDelete: Restrict)
  student             User                   @relation("ContractStudent", fields: [studentId], references: [id], onDelete: Restrict)
  acceptance          ContractAcceptance?
  paymentRecord       PaymentRecord?
  paymentInstallments PaymentInstallment[]
  documentViews       ContractDocumentView[]
  signedFile          StoredFile?            @relation("SignedContractFile", fields: [signedFileId], references: [id], onDelete: Restrict)

  @@unique([versionId, parentId, studentId])
  @@index([schoolId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([studentId, createdAt])
  @@index([signedFileId])
}

model ContractDocument {
  id                    String               @id @default(uuid()) @db.Uuid
  schoolId              String               @db.Uuid
  versionId             String               @db.Uuid
  storedFileId          String               @db.Uuid
  kind                  ContractDocumentKind
  title                 String
  position              Int                  @default(0)
  requiredForAcceptance Boolean              @default(true)
  createdAt             DateTime             @default(now())

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  version    ContractVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  storedFile StoredFile             @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  views      ContractDocumentView[]

  @@unique([versionId, kind])
  @@index([schoolId, createdAt])
  @@index([storedFileId])
}

model ContractDocumentView {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  assignmentId  String   @db.Uuid
  documentId    String   @db.Uuid
  userId        String   @db.Uuid
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assignment ContractAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  document   ContractDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, documentId, userId])
  @@index([schoolId, userId, lastViewedAt])
}

model PaymentInstallment {
  id                String        @id @default(uuid()) @db.Uuid
  schoolId          String        @db.Uuid
  assignmentId      String        @db.Uuid
  changedById       String        @db.Uuid
  installmentNumber Int
  amountCents       Int
  dueDate           DateTime      @db.Date
  status            PaymentStatus @default(UNSET)
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assignment ContractAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  changedBy  User               @relation("PaymentInstallmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([assignmentId, installmentNumber])
  @@index([schoolId, status, dueDate])
}

model ContractAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @unique @db.Uuid
  acceptedById String   @db.Uuid
  documentHash String   @db.Char(64)
  evidence     Json
  acceptedAt   DateTime @default(now())

  assignment ContractAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  acceptedBy User               @relation("ContractAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([acceptedById, acceptedAt])
}

model PaymentRecord {
  id                   String        @id @default(uuid()) @db.Uuid
  schoolId             String        @db.Uuid
  studentId            String        @db.Uuid
  changedById          String        @db.Uuid
  contractAssignmentId String?       @unique @db.Uuid
  period               String
  status               PaymentStatus @default(UNSET)
  dueDate              DateTime?     @db.Date
  note                 String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student            User                @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  changedBy          User                @relation("PaymentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  contractAssignment ContractAssignment? @relation(fields: [contractAssignmentId], references: [id], onDelete: Restrict)

  @@index([schoolId, status, dueDate])
  @@index([studentId, period])
  @@index([schoolId, contractAssignmentId])
}

model ImportBatch {
  id            String       @id @default(uuid()) @db.Uuid
  schoolId      String       @db.Uuid
  createdById   String       @db.Uuid
  sourceFileId  String       @db.Uuid
  status        ImportStatus @default(PREVIEW_READY)
  totalRows     Int
  validRows     Int
  errorRows     Int
  duplicateRows Int
  errorSummary  Json?
  createdAt     DateTime     @default(now())
  committedAt   DateTime?
  archivedAt    DateTime?

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("ImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceFile StoredFile @relation("ImportSource", fields: [sourceFileId], references: [id], onDelete: Restrict)

  @@index([schoolId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([sourceFileId])
}
