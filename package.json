{
  "name": "edziennik-kla",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack && node scripts/prepare-production.mjs",
    "build:preview": "./scripts/build-static-preview.sh",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:snapshot:create": "node --env-file=.env scripts/demo-database-snapshot.mjs create",
    "db:snapshot:verify": "node --env-file=.env scripts/demo-database-snapshot.mjs verify",
    "db:snapshot:restore": "node --env-file=.env scripts/demo-database-snapshot.mjs restore",
    "db:demo:reset:clean": "node --env-file=.env scripts/reset-demo-database.mjs --clean --confirm=RESET_SYNTHETIC_DEMO",
    "db:demo:reset:rich": "node --env-file=.env scripts/reset-demo-database.mjs --rich --confirm=RESET_SYNTHETIC_DEMO",
    "db:first-run:reset": "node --env-file-if-exists=.env scripts/reset-to-first-run.mjs --confirm=EMPTY_FIRST_RUN",
    "export:demo-school": "tsx scripts/export-demo-school.ts",
    "security:rotate-demo-password": "node --env-file=.env scripts/rotate-demo-password.mjs",
    "account:owner": "node --env-file-if-exists=.env scripts/setup-system-owner.mjs",
    "pilot:mfa:sync": "node --env-file=.env scripts/apply-director-mfa-policy.mjs",
    "host:mac:start": "./scripts/mac-test-host-start.sh",
    "host:mac:status": "./scripts/mac-test-host-status.sh",
    "host:mac:stop": "./scripts/mac-test-host-stop.sh",
    "security:check": "node scripts/check-no-secrets.mjs && node scripts/check-migrations-safe.mjs",
    "check": "npm run lint && npm run typecheck && npm run db:validate && npm run test && npm run security:check",
    "package:release": "./scripts/package-release.sh",
    "package:vps": "./scripts/package-home-vps.sh",
    "package:preview": "./scripts/package-home-preview.sh",
    "check:raspberry": "./raspberry/test-package.sh",
    "package:raspberry": "npm run check:raspberry && ./scripts/package-raspberry.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.25",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.2.3",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.16.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "7.8.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  },
  "type": "module"
}
