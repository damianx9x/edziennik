Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Jedna główna wersja adresu.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.kingslanguageacademy\.pl$ [NC]
RewriteRule ^ https://kingslanguageacademy.pl%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), display-capture=(self), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "(^\.|\.env|\.log|\.sql|\.sqlite|\.bak|\.zip)$">
  Require all denied
</FilesMatch>
