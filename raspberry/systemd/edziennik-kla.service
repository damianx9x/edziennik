[Unit]
Description=KLA eDziennik
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
RequiresMountsFor=/srv/kla-vault
ConditionPathIsMountPoint=/srv/kla-vault

[Service]
Type=simple
User=kla
Group=kla
WorkingDirectory=/opt/kla/current
EnvironmentFile=/etc/kla/edziennik.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kla-vault/private-files
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
