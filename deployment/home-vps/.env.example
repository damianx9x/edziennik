# Ten plik jest wzorem. Instalator sam tworzy prywatny plik .env.
APP_DOMAIN=staging.kingslanguageacademy.pl
POSTGRES_DB=kla_edziennik
POSTGRES_USER=kla_app
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://kla_app:CHANGE_ME@db:5432/kla_edziennik?schema=public
BETTER_AUTH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
BETTER_AUTH_URL=https://staging.kingslanguageacademy.pl
NEXT_PUBLIC_APP_URL=https://staging.kingslanguageacademy.pl
NEXT_PUBLIC_APP_RELEASE=0.5.0-stage-2
NEXT_PUBLIC_SUPPORT_EMAIL=kingsjezykiobce@gmail.com
NEXT_PUBLIC_KLA_SSH_URL=
KLA_SYSTEM_OWNER_SCHOOL_SLUG=kings-language-academy-demo
KLA_REQUIRE_DIRECTOR_MFA=1
FILE_STORAGE_PROVIDER=local
KLA_PRIVATE_FILES_DIR=/app/.data/private-files
EMAIL_FROM=
RESEND_API_KEY=
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_MONTHLY_LIMIT=200
MESSAGE_REFRESH_MS=8000
LOG_LEVEL=info
