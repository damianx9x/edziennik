# Skopiuj do .env. Nigdy nie commituj prawdziwych haseł.
DATABASE_URL="postgresql://edziennik:edziennik@127.0.0.1:5432/edziennik_kla?schema=public"
# Zwykły PostgreSQL: 5. Dla lokalnego `prisma dev` na porcie 51214 aplikacja
# automatycznie używa 1, bo ten serwer przyjmuje tylko jedno połączenie naraz.
KLA_DATABASE_POOL_MAX="5"
SHADOW_DATABASE_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Dodatkowe pełne originy rozdzielone przecinkami, bez ścieżki i wildcardów.
# Zostaw puste na produkcji, jeśli używasz wyłącznie BETTER_AUTH_URL.
KLA_AUTH_TRUSTED_ORIGINS=""
KLA_DEMO_PASSWORD=""
KLA_DEMO_DIRECTOR_PASSWORD=""
KLA_DEMO_TEACHER_PASSWORD=""
KLA_DEMO_PARENT_PASSWORD=""
KLA_DEMO_STUDENT_PASSWORD=""
KLA_SYSTEM_OWNER_PASSWORD=""
KLA_ALLOW_INSECURE_DEMO_CREDENTIALS="0"
KLA_SYSTEM_OWNER_SCHOOL_SLUG="kings-language-academy-demo"
KLA_PUBLIC_SCHOOL_SLUG="kings-language-academy-demo"
# Ustaw na 1 wyłącznie przy świadomym odzyskiwaniu MFA właściciela systemu.
KLA_SYSTEM_OWNER_RESET_MFA="0"
# Pilot: 0. Przed wprowadzeniem prawdziwych danych ustaw 1.
KLA_REQUIRE_DIRECTOR_MFA="0"
# Etap 5: adapter HTTP dostawcy e-mail. Puste wartości bezpiecznie zatrzymują
# wysyłkę w kolejce zamiast udawać, że e-mail został dostarczony.
KLA_EMAIL_API_URL=""
KLA_EMAIL_API_TOKEN=""
KLA_EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="https://kingslanguageacademy.pl"
NEXT_PUBLIC_APP_RELEASE="0.5.0-stage-5"
NEXT_PUBLIC_SUPPORT_EMAIL="kingsjezykiobce@gmail.com"
LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
FILE_STORAGE_PROVIDER="local"
KLA_PRIVATE_FILES_DIR=".data/private-files"
# `required` na produkcji: każdy zapisywany plik musi przejść przez ClamAV.
# Awaria skanera blokuje upload zamiast przepuszczać plik bez kontroli.
KLA_MALWARE_SCAN_MODE="off"
KLA_CLAMAV_SOCKET="/run/clamav/clamd.ctl"
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SIGNATURE_PROVIDER="internal"
MESSAGE_REFRESH_MS="8000"
SMS_PROVIDER="disabled"
SMS_API_KEY=""
SMS_MONTHLY_LIMIT="200"
